# ═══════════════════════════════════════════════════════════════
# CREM — Configuración API TrendAI Vision One
# Coloca este archivo en: [EMPRESA]/.env
# ═══════════════════════════════════════════════════════════════

# API Key de TrendAI Vision One
# Cómo obtenerla:
#   1. Entra en https://portal.eu.xdr.trendmicro.com
#   2. Administration → User Roles → + Add role
#      - "Can be assigned to API keys" = Yes
#      - Permisos: Dashboards & Reports → Reports → Configure and download + View
#        (cubre attack-surface devices, vulnerable devices, high-risk devices,
#        public IPs, asset groups) + "Third-party auditing (API only)"
#        (necesario específicamente para el endpoint securityPosture)
#      - Data and app assets: define el scope de activos necesario
#   3. Administration → API Keys → crea o edita la key con ese rol nuevo
#      (el rol "Operator" NO incluye permiso de Reports y da 403 en CREM)
#   4. Confirma que el toggle "Status" de la key esté activado
TRENDAI_API_KEY=

# Región del servidor Vision One
# EU = Europa (España)     → api.eu.xdr.trendmicro.com
# US = Estados Unidos      → api.xdr.trendmicro.com
# AU = Australia           → api.au.xdr.trendmicro.com
# IN = India               → api.in.xdr.trendmicro.com
# SG = Singapur            → api.sg.xdr.trendmicro.com
# JP = Japón               → api.jp.xdr.trendmicro.com
TRENDAI_REGION=EU

# (Opcional) Filtro TMV1-Filter aplicado a los endpoints CREM/ASRM para acotar
# por origen de datos, ej: discoveredBy hassubset(['Server & Workload Protection'])
# Vacío = sin filtro (incluye todos los orígenes conectados, incl. escáneres de terceros)
TRENDAI_DISCOVERED_BY_FILTER=

